# ─── Database (MySQL — Hostinger Business) ─────────────────────────────
# Create a DB in hPanel → Databases, then use its credentials here.
DATABASE_URL="mysql://user:password@host:3306/dbname"

# ─── Auth (NextAuth / Auth.js v5) ──────────────────────────────────────
# Login is username + password (self-service signup at /signup). Required.
# Generate: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Optional Google OAuth (leave blank to use username/password only).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Admin account created by `npm run db:seed` (change after first login).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin!2026"

# ─── Secret encryption (AES-256-GCM for stored API keys) ───────────────
# 32-byte key, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# ─── AI providers (FREE tiers, used in fallback order) ─────────────────
# Set at least one. Routing/fallback order lives in src/lib/ai/models.ts.
#
# 1) Google Gemini — PRIMARY. Free ~1,500 req/day, no card. Get a key at
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# 2) Groq — fast fallback. Free ~14ك req/day. https://console.groq.com/keys
GROQ_API_KEY=""
# 3) OpenRouter — last-resort fallback (:free models, 50/day). Optional.
OPENROUTER_API_KEY=""

# Optional per-task model overrides (else sensible free defaults are used):
# MODEL_ANALYSIS="gemini-2.0-flash"
# MODEL_SCORING="gemini-2.0-flash-lite"
# MODEL_EMAIL="gemini-2.0-flash"
# MODEL_RESEARCH="gemini-2.0-flash-lite"

# Optional OpenRouter attribution headers
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="AIToolSender"

# ─── Lead discovery (FREE search) ──────────────────────────────────────
# Serper.dev — free 2,500 searches/month, no card. https://serper.dev
# (Google CSE is closed to new customers; only set GOOGLE_CSE_* if you already
#  have a key.) Without either, use CSV lead import — no key needed.
SERPER_API_KEY=""
# DISCOVERY_PROVIDER="serper"   # manual | serper | google-cse
# GOOGLE_CSE_KEY=""
# GOOGLE_CSE_CX=""

# ─── Email delivery (FREE) ─────────────────────────────────────────────
# Resend free: 100/day, 3,000/mo — covers 50/day. https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="you@yourverifieddomain.com"
EMAIL_FROM_NAME="Your Name"
# CAN-SPAM: a real physical mailing address is legally required in footers.
EMAIL_MAILING_ADDRESS="123 Example St, City, Country"

# SMTP fallback (auto-used if Resend fails, or when a sender uses channel=SMTP).
# Brevo free: 300/day, full SMTP — host smtp-relay.brevo.com, port 587.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ─── App / tracking ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Secret for signing tracking + unsubscribe links
TRACKING_SECRET=""

# ─── Agent cron auth ───────────────────────────────────────────────────
# Bearer token the daily cron must present to POST /api/agent/run
CRON_SECRET=""
